cat << 'EOF' > .gitignore
# ==========================================
# IDEs e Editores (IntelliJ / VS Code)
# ==========================================
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/
*.code-workspace

# ==========================================
# Backend — Java / Spring Boot (Maven e Gradle)
# ==========================================
target/
build/
.gradle/
logs/
*.log
*.jar
*.war
*.ear
!**/.mvn/wrapper/maven-wrapper.jar

# ==========================================
# Frontend — Angular / Node
# ==========================================
node_modules/
dist/
.angular/
coverage/
tmp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Variáveis de Ambiente e Segredos (OWASP)
# ==========================================
.env
.env.*
!.env.example
**/application-local.properties
**/application-local.yml
**/application-prod.properties
**/application-prod.yml
*.pem
*.key

# ==========================================
# Sistema Operacional
# ==========================================
*~
.directory
.DS_Store
Thumbs.db
EOF

rm -f backend/mini-glpi/.gitignore
git status